+static char *get_compiler_path(const char *name)
+{
+    const char *search_path, *base, *p;
+    char *found, *path;
+    DWORD len, ret;
+    size_t name_len;
+
+    if (strpbrk(name, "\\/:")) {
+        name_len = strlen(name);
+        found = malloc(name_len + sizeof(".exe"));
+        if (!found)
+            return NULL;
+        memcpy(found, name, name_len + 1);
+        base = strrchr(name, '\\');
+        p = strrchr(name, '/');
+        if (p && (!base || p > base))
+            base = p;
+        if (!base)
+            base = name;
+        if (!strchr(base, '.'))
+            strcat(found, ".exe");
+    } else {
+        search_path = getenv("PATH");
+        if (!search_path || !*search_path)
+            return NULL;
+        len = SearchPathA(search_path, name, ".exe", 0, NULL, NULL);
+        if (!len)
+            return NULL;
+        found = malloc(len);
+        if (!found)
+            return NULL;
+        ret = SearchPathA(search_path, name, ".exe", len, found, NULL);
+        if (!ret || ret >= len) {
+            free(found);
+            return NULL;
+        }
+    }
+
+    len = GetFullPathNameA(found, 0, NULL, NULL);
+    if (!len) {
+        free(found);
+        return NULL;
+    }
+    path = malloc(len);
+    if (!path) {
+        free(found);
+        return NULL;
+    }
+    ret = GetFullPathNameA(found, len, path, NULL);
+    free(found);
+    if (!ret || ret >= len) {
